#!/usr/bin/env php
<?php
/**
 * sunrinns-admin — 실습용 계정 관리 도구 (웹 서버에서 실행)
 *
 * 웹 화면으로는 풀 수 없는 상황을 위한 안전망이다.
 *  - OTP 비밀키와 백업 코드를 둘 다 잃어버려 완전히 잠긴 계정
 *  - 실수로 삭제한 계정의 복구
 *  - 유예 기간이 지난 계정의 실제 삭제(purge)
 *  - 실습 환경을 기본 상태로 되돌리기
 *
 * 사용법:
 *   sunrinns-admin list
 *   sunrinns-admin show     <아이디>
 *   sunrinns-admin restore  <아이디>              삭제 예약 취소
 *   sunrinns-admin reset-otp <아이디>             새 OTP 비밀키 발급
 *   sunrinns-admin codes    <아이디>              새 백업 코드 발급
 *   sunrinns-admin passwd   <아이디> <새비밀번호>
 *   sunrinns-admin create   <아이디> <비밀번호>
 *   sunrinns-admin purge                          유예 기간 지난 계정 실제 삭제
 *   sunrinns-admin seed                           실습 기본 계정(student) 보장
 */

const DB = '/var/lib/sunrinns/app.db';
require_once '/var/www/html/lib/totp.php';

// head 등으로 파이프가 끊겨도 Notice 를 뿌리지 않도록 echo 를 쓴다.
function out(string $s = ''): void { echo $s, "\n"; }
function fail(string $s): void { fwrite(STDERR, "오류: $s\n"); exit(1); }

if (!file_exists(DB)) fail('DB를 찾을 수 없습니다: ' . DB);
$pdo = new PDO('sqlite:' . DB);
$pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

$GRACE = 7;   // lib/db.php 의 DELETE_GRACE_DAYS 와 맞춘다

function codeNew(): string {
    $a = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; $s = '';
    for ($i = 0; $i < 8; $i++) { if ($i === 4) $s .= '-'; $s .= $a[random_int(0, strlen($a) - 1)]; }
    return $s;
}
function issueCodes(PDO $pdo, string $u, int $n = 8): array {
    $pdo->prepare('DELETE FROM recovery_codes WHERE username = ?')->execute([$u]);
    $ins = $pdo->prepare('INSERT INTO recovery_codes (username, code_hash) VALUES (?,?)');
    $out = [];
    for ($i = 0; $i < $n; $i++) { $c = codeNew(); $out[] = $c; $ins->execute([$u, password_hash($c, PASSWORD_DEFAULT)]); }
    return $out;
}
function mustUser(PDO $pdo, string $u): array {
    $st = $pdo->prepare('SELECT * FROM users WHERE username = ?');
    $st->execute([$u]);
    $r = $st->fetch(PDO::FETCH_ASSOC);
    if (!$r) fail("계정을 찾을 수 없습니다: $u");
    return $r;
}

$cmd = $argv[1] ?? 'list';
$arg = $argv[2] ?? null;

switch ($cmd) {

case 'list':
    $rows = $pdo->query('SELECT username, created_at, deleted_at FROM users ORDER BY id')->fetchAll(PDO::FETCH_ASSOC);
    if (!$rows) { out('계정이 없습니다. "sunrinns-admin seed" 로 기본 계정을 만들 수 있습니다.'); break; }
    printf("%-20s %-21s %-12s %s\n", '아이디', '가입', '상태', '백업코드');
    foreach ($rows as $r) {
        $st = $pdo->prepare('SELECT COUNT(*) FROM recovery_codes WHERE username = ? AND used_at IS NULL');
        $st->execute([$r['username']]);
        $state = '정상';
        if (!empty($r['deleted_at'])) {
            $left = $GRACE - (int)floor((time() - strtotime($r['deleted_at'] . ' UTC')) / 86400);
            $state = $left > 0 ? "삭제예정 {$left}일" : '삭제대기(만료)';
        }
        printf("%-20s %-21s %-12s %d개\n", $r['username'], $r['created_at'], $state, $st->fetchColumn());
    }
    break;

case 'show':
    if (!$arg) fail('아이디를 지정하세요.');
    $r = mustUser($pdo, $arg);
    out("아이디      : {$r['username']}");
    out("가입        : {$r['created_at']}");
    out('상태        : ' . (empty($r['deleted_at']) ? '정상' : "삭제 예약됨 ({$r['deleted_at']})"));
    $st = $pdo->prepare('SELECT COUNT(*) FROM recovery_codes WHERE username = ? AND used_at IS NULL');
    $st->execute([$arg]);
    out('남은 백업코드: ' . $st->fetchColumn() . '개');
    out('');
    out('현재 OTP 코드: ' . totp_at($r['totp_secret']));
    out('(비밀키 자체는 출력하지 않습니다. 필요하면 reset-otp 로 새로 발급하세요.)');
    break;

case 'restore':
    if (!$arg) fail('아이디를 지정하세요.');
    mustUser($pdo, $arg);
    $pdo->prepare('UPDATE users SET deleted_at = NULL WHERE username = ?')->execute([$arg]);
    $pdo->prepare("INSERT INTO login_log (username,stage,result,src_ip) VALUES (?,'restore','ok','cli')")->execute([$arg]);
    out("복구 완료: $arg");
    break;

case 'reset-otp':
    if (!$arg) fail('아이디를 지정하세요.');
    mustUser($pdo, $arg);
    $s = totp_secret_new();
    $pdo->prepare('UPDATE users SET totp_secret = ? WHERE username = ?')->execute([$s, $arg]);
    $pdo->prepare("INSERT INTO login_log (username,stage,result,src_ip) VALUES (?,'otp-reset','ok','cli')")->execute([$arg]);
    out("새 OTP 비밀키: $s");
    out('인증 앱에 다시 등록하세요.');
    out("터미널 확인 : oathtool --totp -b $s");
    break;

case 'codes':
    if (!$arg) fail('아이디를 지정하세요.');
    mustUser($pdo, $arg);
    out('새 백업 코드 (각 1회용):');
    foreach (issueCodes($pdo, $arg) as $c) out("  $c");
    $pdo->prepare("INSERT INTO login_log (username,stage,result,src_ip) VALUES (?,'recovery-gen','ok','cli')")->execute([$arg]);
    break;

case 'passwd':
    $pw = $argv[3] ?? null;
    if (!$arg || !$pw) fail('사용법: sunrinns-admin passwd <아이디> <새비밀번호>');
    mustUser($pdo, $arg);
    $pdo->prepare('UPDATE users SET pwhash = ? WHERE username = ?')
        ->execute([password_hash($pw, PASSWORD_DEFAULT), $arg]);
    $pdo->prepare("INSERT INTO login_log (username,stage,result,src_ip) VALUES (?,'pwchange','ok','cli')")->execute([$arg]);
    out("비밀번호 변경 완료: $arg");
    break;

case 'create':
    $pw = $argv[3] ?? null;
    if (!$arg || !$pw) fail('사용법: sunrinns-admin create <아이디> <비밀번호>');
    if (!preg_match('/^[A-Za-z0-9_]{3,20}$/', $arg)) fail('아이디는 영문·숫자·밑줄 3~20자');
    $st = $pdo->prepare('SELECT COUNT(*) FROM users WHERE username = ?'); $st->execute([$arg]);
    if ($st->fetchColumn()) fail("이미 있는 아이디입니다: $arg");
    $s = totp_secret_new();
    $pdo->prepare('INSERT INTO users (username,pwhash,totp_secret) VALUES (?,?,?)')
        ->execute([$arg, password_hash($pw, PASSWORD_DEFAULT), $s]);
    $pdo->prepare("INSERT INTO login_log (username,stage,result,src_ip) VALUES (?,'signup','ok','cli')")->execute([$arg]);
    out("생성 완료: $arg");
    out("OTP 비밀키: $s");
    out('백업 코드 :');
    foreach (issueCodes($pdo, $arg) as $c) out("  $c");
    break;

case 'purge':
    $rows = $pdo->query('SELECT username, deleted_at FROM users WHERE deleted_at IS NOT NULL')->fetchAll(PDO::FETCH_ASSOC);
    $n = 0;
    foreach ($rows as $r) {
        $left = $GRACE - (int)floor((time() - strtotime($r['deleted_at'] . ' UTC')) / 86400);
        if ($left > 0) { out("건너뜀 (아직 {$left}일 남음): {$r['username']}"); continue; }
        $pdo->prepare('DELETE FROM users WHERE username = ?')->execute([$r['username']]);
        $pdo->prepare('DELETE FROM recovery_codes WHERE username = ?')->execute([$r['username']]);
        // 감사 기록(login_log)은 남긴다 — 삭제 사실 자체는 추적돼야 한다.
        out("영구 삭제: {$r['username']}");
        $n++;
    }
    out("완료: {$n}건 삭제");
    break;

case 'seed':
    $st = $pdo->prepare('SELECT COUNT(*) FROM users WHERE username = ?'); $st->execute(['student']);
    if ($st->fetchColumn()) {
        $pdo->prepare('UPDATE users SET deleted_at = NULL WHERE username = ?')->execute(['student']);
        out('student 계정이 이미 있습니다. 삭제 예약만 해제했습니다.');
    } else {
        $s = totp_secret_new();
        $pdo->prepare('INSERT INTO users (username,pwhash,totp_secret) VALUES (?,?,?)')
            ->execute(['student', password_hash('sunrin2026', PASSWORD_DEFAULT), $s]);
        out('student 계정을 새로 만들었습니다.');
        out('  비밀번호   : sunrin2026');
        out("  OTP 비밀키 : $s");
        out('백업 코드 :');
        foreach (issueCodes($pdo, 'student') as $c) out("  $c");
    }
    break;

default:
    out('사용법:');
    out('  sunrinns-admin list');
    out('  sunrinns-admin show      <아이디>');
    out('  sunrinns-admin restore   <아이디>');
    out('  sunrinns-admin reset-otp <아이디>');
    out('  sunrinns-admin codes     <아이디>');
    out('  sunrinns-admin passwd    <아이디> <새비밀번호>');
    out('  sunrinns-admin create    <아이디> <비밀번호>');
    out('  sunrinns-admin purge');
    out('  sunrinns-admin seed');
}
